{
  "name": "poolsync-agent",
  "version": "0.2.2",
  "type": "commonjs",
  "description": "PoolSync Agent — controla o OBS local em nome da app PoolSync",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "status": "node index.js status",
    "scenes": "node index.js scenes",
    "build:native": "csc /nologo /target:exe /platform:x64 /out:native\\CamCtl.exe native\\CamCtl.cs",
    "build": "pkg . --targets node22-win-x64 --output dist/PoolSyncAgent.exe"
  },
  "pkg": {
    "assets": [
      "native/CamCtl.exe"
    ]
  },
  "keywords": [],
  "author": "PoolSync",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "obs-websocket-js": "^5.0.8",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  }
}
