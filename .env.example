# PoolSync Agent — configuração local (copiar para .env)

# ── OBS WebSocket (na máquina do operador) ──
# Tools → WebSocket Server Settings no OBS. Deixa a password vazia se estiver desligada.
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_PASSWORD=

# ── Ligação à app PoolSync ──
# Deixa em branco para modo local (só CLI, sem controlo remoto).
# Preenche para o agente aparecer no painel do admin.
SERVER_URL=
DEVICE_KEY=
USER_HANDLE=

# ── Opcional ──
# VERBOSE=true
# OBS_RECONNECT_MS=3000
# OBS_RECONNECT_MAX_MS=30000
